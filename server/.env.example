PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/food-delivery
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=your_jwt_access_secret_here_replace_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_replace_in_production
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=10d

CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=TEST

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="AnyFeast <noreply@anyfeast.com>"

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=debug
